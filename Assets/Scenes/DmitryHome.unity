  customPresentation: 1
  introduction: "\u0414\u043E\u043C \u0414\u043C\u0438\u0442\u0440\u0438\u044F. \u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0432\u0435\u0449\u0438 \u0438 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u0441 \u0445\u043E\u0437\u044F\u0438\u043D\u043E\u043C. \u041C\u0430\u0448\u0438\u043D\u0430 \u0436\u0434\u0451\u0442 \u043F\u0435\u0440\u0435\u0434 \u0432\u0445\u043E\u0434\u043E\u043C."
