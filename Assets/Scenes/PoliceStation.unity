--- !u!114 &155868305
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 155868303}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c129e41183d404a309f4e48367e87fd8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.LocationKit.LocationRoot
  locationName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A"
  customPresentation: 1
  introduction: "\u0422\u0440\u0438 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434 \u0434\u0435\u043B\u043E \u043E\u0442\u0446\u0430 \u0437\u0430\u043A\u0440\u044B\u043B\u0438 \u043A\u0430\u043A \u0441\u0430\u043C\u043E\u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E.\n\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u044B \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044B.\n\n\u0410\u0440\u0445\u0438\u0432 \u2014 \u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430 \u0441\u043F\u0440\u0430\u0432\u0430. \u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0434\u0435\u043B\u043E \u0412-97/041.\n\u0421\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B, \u043E\u043F\u0438\u0441\u044C \u043E\u0440\u0443\u0436\u0438\u044F \u0438 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u0430."
  objective: "\u0410\u0440\u0445\u0438\u0432 \u2192 \u0434\u0435\u043B\u043E \u0412-97/041 \xB7 \u0441\u043E\u0431\u0435\u0440\u0438\u0442\u0435 3 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430 \xB7 \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0435 \u043A\u0430\u043B\u0438\u0431\u0440\u044B \u043D\u0430 \u0434\u043E\u0441\u043A\u0435 [Tab]"
  game: {fileID: 1789273100}
  spawn: {fileID: 145162870}
  architecture: {fileID: 568090355}
  props: {fileID: 1577394644}
  lights: {fileID: 2109626128}
  gameplay: {fileID: 1597784063}
