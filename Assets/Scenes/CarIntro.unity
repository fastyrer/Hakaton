  m_Script: {fileID: 11500000, guid: 2ea85b00cbedd401c903924f6eb52ce3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.FatherHouse.HouseDocument
  kind: 5
  evidenceId: -1
  label: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C: \u0421\u043F\u0438\u0441\u043E\u043A \u043A\u043D\u0438\u0433"
  illustration: {fileID: 0}
  heading: "\u0421\u043F\u0438\u0441\u043E\u043A \u043A\u043D\u0438\u0433"
  body: "\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u043E\u043A\u0440\u0443\u0433\u0430 \u2014 \u043F\u043E\u043B\u043A\u0430 II.\n\u0422\u0435\u043B\u0435\u0444\u043E\u043D\u043D\u044B\u0435 \u0441\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u0438\u043A\u0438 \u2014 \u043F\u043E\u043B\u043A\u0430 IV.\n\u0421\u0442\u0430\u0440\u044B\u0435 \u0434\u0435\u043B\u0430 \u2014 \u0432 \u0441\u0435\u043C\u0435\u0439\u043D\u043E\u043C \u0430\u0440\u0445\u0438\u0432\u0435.\n\n\u041A\u0440\u0430\u0441\u043D\u0443\u044E \u043A\u043D\u0438\u0433\u0443 \u043D\u0435 \u0443\u043D\u043E\u0441\u0438\u0442\u044C \u0438\u0437 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430. \u041A\u043E\u0440\u0435\u0448\u043E\u043A \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E."
