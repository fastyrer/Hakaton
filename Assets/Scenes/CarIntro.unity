--- !u!114 &406041050
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 406041048}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32ddcf703b00d4411a98ea987d7d3dde, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.DemoGame
  arrivalScene: 1
  locationTitle: "\u0414\u043E\u043C \u043E\u0442\u0446\u0430"
  locationIntroduction: "\u0417\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C\u0438 \u0434\u043E\u043C\u0430\u043C\u0438 \u0434\u043E\u0440\u043E\u0433\u0430 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0432 \u043B\u0435\u0441\u043D\u0443\u044E \u043A\u043E\u043B\u0435\u044E.\n\u041E\u0442\u0435\u0446 \u0432\u0435\u043B\u0435\u043B \u043D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435 \u0441\u043E\u043E\u0431\u0449\u0430\u0442\u044C \u044D\u0442\u043E\u0442 \u0430\u0434\u0440\u0435\u0441.\n\n\u041E\u043A\u043D\u0430 \u0437\u0430\u043A\u043E\u043B\u043E\u0447\u0435\u043D\u044B \u0438\u0437\u043D\u0443\u0442\u0440\u0438. \u041D\u0430 \u0434\u0432\u0435\u0440\u0438 \u2014 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0441\u043E\u0432\u043E\u0432.\n\u041C\u0430\u0448\u0438\u043D\u0430 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0443 \u0432\u043E\u0440\u043E\u0442. \u041D\u0443\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u0435\u0433\u043E \u043A\u0430\u0431\u0438\u043D\u0435\u0442."
  locationObjective: "\u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0434\u043E\u043C \u043E\u0442\u0446\u0430 \xB7 E \u2014 \u043E\u0441\u043C\u043E\u0442\u0440 \u0438 \u0434\u0432\u0435\u0440\u0438 \xB7 Tab \u2014 \u0434\u043E\u0441\u043A\u0430 \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F"
  player: {fileID: 1145247630}
  hud: {fileID: 725541456}
  board: {fileID: 406041052}
  sound: {fileID: 406041051}
  kitchenDoor: {fileID: 0}
