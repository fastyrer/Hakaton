  m_GameObject: {fileID: 1416763884}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ea85b00cbedd401c903924f6eb52ce3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.FatherHouse.HouseDocument
  kind: 5
  evidenceId: -1
  label: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C: \u0415\u0441\u043B\u0438 \u044F \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u0441\u044C"
  illustration: {fileID: 0}
  heading: "\u0415\u0441\u043B\u0438 \u044F \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u0441\u044C"
  body: "\u0421\u044B\u043D\u043E\u0432\u044C\u044F, \u043F\u0440\u043E\u0441\u0442\u0438\u0442\u0435 \u043C\u0435\u043D\u044F. \u042F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043F\u043E\u0437\u0434\u043D\u043E \u043F\u043E\u043D\u044F\u043B, \u0447\u0442\u043E \u0431\u0443\u043C\u0430\u0433\u0438 \u0438\u0437 \u0443\u0447\u0430\u0441\u0442\u043A\u0430 \u0432\u0430\u0436\u043D\u0435\u0435 \u043B\u044E\u0431\u043E\u0433\u043E \u043E\u0440\u0443\u0436\u0438\u044F.\n\n\u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044B \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u044B \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u0443 \u0442\u0435\u0445, \u043A\u0442\u043E \u043D\u0430\u0437\u0432\u0430\u043B \u044D\u0442\u043E \u0441\u0430\u043C\u043E\u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E\u043C. \u041D\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u0439\u0442\u0435 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u044B\u043C \u043A\u043E\u043F\u0438\u044F\u043C. \u0418\u0449\u0438\u0442\u0435 \u0442\u043E, \u0447\u0442\u043E \u043D\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0435\u0442.\n\n\u041A\u043D\u0438\u0433\u0443 \u0441 \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u043C \u043A\u0440\u0430\u0441\u043D\u044B\u043C \u043A\u043E\u0440\u0435\u0448\u043A\u043E\u043C \u044F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u043B\u044F\u044E."
