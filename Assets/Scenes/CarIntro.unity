  m_Script: {fileID: 11500000, guid: 2ea85b00cbedd401c903924f6eb52ce3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.FatherHouse.HouseDocument
  kind: 5
  evidenceId: -1
  label: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C: \u0414\u043B\u044F \u0433\u043E\u0441\u0442\u044F"
  illustration: {fileID: 0}
  heading: "\u0414\u043B\u044F \u0433\u043E\u0441\u0442\u044F"
  body: "\u041F\u043E\u0441\u0442\u0435\u043B\u044C \u0447\u0438\u0441\u0442\u0430\u044F. \u041D\u0435 \u0434\u0432\u0438\u0433\u0430\u0439 \u0447\u0435\u043C\u043E\u0434\u0430\u043D.\n\n\u0415\u0441\u043B\u0438 \u0443\u0441\u043B\u044B\u0448\u0438\u0448\u044C \u0441\u0442\u0443\u043A \u0432 \u043E\u043A\u043D\u043E, \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0439. \u0412 \u044D\u0442\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043E\u043A\u043D\u0430 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F."
