MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1558840974}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ea85b00cbedd401c903924f6eb52ce3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.FatherHouse.HouseDocument
  kind: 5
  evidenceId: -1
  label: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C: \u041D\u043E\u0447\u043D\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C"
  illustration: {fileID: 0}
  heading: "\u041D\u043E\u0447\u043D\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C"
  body: "\u042F \u043D\u0435 \u0441\u043F\u0430\u043B \u0442\u0440\u0435\u0442\u044C\u044E \u043D\u043E\u0447\u044C. \u0412 \u0433\u043E\u0441\u0442\u0435\u0432\u043E\u0439 \u043A\u0442\u043E-\u0442\u043E \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u043D\u0443\u043B \u0447\u0435\u043C\u043E\u0434\u0430\u043D.\n\n\u041D\u0435\u043B\u044C\u0437\u044F \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0441\u0432\u0435\u0442 \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435: \u0438\u0437 \u043B\u0435\u0441\u0430 \u0432\u0438\u0434\u043D\u043E \u0441\u0438\u043B\u0443\u044D\u0442.\n\n\u041F\u0440\u043E\u0445\u043E\u0434 \u0437\u0430 \u0448\u043A\u0430\u0444\u043E\u043C \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D. \u0414\u043E\u0441\u043A\u0430 \u0443 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u044B \u0441\u043A\u0440\u0438\u043F\u0438\u0442 \u2014 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u044C \u0431\u043B\u0438\u0436\u0435 \u043A \u043A\u0440\u0430\u044E."
