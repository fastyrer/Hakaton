  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ea85b00cbedd401c903924f6eb52ce3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.FatherHouse.HouseDocument
  kind: 5
  evidenceId: -1
  label: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C: \u041A\u0430\u0440\u0442\u0430 \u043E\u0431\u0445\u043E\u0434\u043E\u0432"
  illustration: {fileID: 0}
  heading: "\u041A\u0430\u0440\u0442\u0430 \u043E\u0431\u0445\u043E\u0434\u043E\u0432"
  body: "\u041E\u0431\u044B\u0447\u043D\u0443\u044E \u0434\u043E\u0440\u043E\u0433\u0443 \u0432\u0438\u0434\u043D\u043E \u0441 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438.\n\u0421\u0435\u0432\u0435\u0440\u043D\u0430\u044F \u0442\u0440\u043E\u043F\u0430 \u0432\u0435\u0434\u0451\u0442 \u043A \u0441\u0442\u0430\u0440\u043E\u043C\u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0443.\n\u0421\u0430\u0440\u0430\u0439 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0451\u043C.\n\n\u0422\u0440\u0438 \u043E\u0442\u043C\u0435\u0442\u043A\u0438 \u043D\u0430 \u043A\u0430\u0440\u0442\u0435 \u043D\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u044E\u0442 \u0441 \u043F\u043B\u0430\u043D\u043E\u043C \u043E\u043A\u0440\u0443\u0433\u0430. \u041A\u0442\u043E-\u0442\u043E \u0441\u0442\u0451\u0440 \u0441\u0442\u0430\u0440\u043E\u0435 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435."
