--- !u!114 &727284849
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 727284847}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ea85b00cbedd401c903924f6eb52ce3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.FatherHouse.HouseDocument
  kind: 5
  evidenceId: -1
  label: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C: \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043A\u043E\u043D\u0432\u0435\u0440\u0442"
  illustration: {fileID: 0}
  heading: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043A\u043E\u043D\u0432\u0435\u0440\u0442"
  body: "\u0417\u0434\u0435\u0441\u044C \u043D\u0435\u0442 \u043E\u0440\u0443\u0436\u0438\u044F. \u0417\u0434\u0435\u0441\u044C \u0442\u043E, \u0440\u0430\u0434\u0438 \u0447\u0435\u0433\u043E \u0437\u0430 \u043C\u043D\u043E\u0439 \u0441\u043B\u0435\u0434\u044F\u0442.\n\n\u042F \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E \u0432\u0435\u0440\u0441\u0438\u0439 \u043E\u0434\u043D\u043E\u0433\u043E \u0441\u043E\u0431\u044B\u0442\u0438\u044F. \u0421\u0432\u0435\u0440\u044C\u0442\u0435 \u0434\u0430\u0442\u0443, \u043E\u0440\u0443\u0436\u0438\u0435 \u0438 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u0430. \u0411\u0443\u043C\u0430\u0433\u0430 \u043D\u0435 \u0443\u043C\u0435\u0435\u0442 \u043F\u043E\u043C\u043D\u0438\u0442\u044C, \u043D\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u0447\u0443\u0436\u0443\u044E \u043E\u0448\u0438\u0431\u043A\u0443.\n\n\u041D\u0435 \u0432\u0435\u0440\u044C\u0442\u0435 \u043F\u0435\u0440\u0432\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438."
