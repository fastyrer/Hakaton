--- !u!114 &1435603324
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1435603322}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ea85b00cbedd401c903924f6eb52ce3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.FatherHouse.HouseDocument
  kind: 5
  evidenceId: -1
  label: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C: \u0416\u0443\u0440\u043D\u0430\u043B \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F"
  illustration: {fileID: 0}
  heading: "\u0416\u0443\u0440\u043D\u0430\u043B \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F"
  body: "02:14 \u2014 \u0441\u0432\u0435\u0442 \u0443 \u0441\u0430\u0440\u0430\u044F.\n02:17 \u2014 \u043A\u0430\u043C\u0435\u0440\u0430 3 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430 \u0441\u0438\u0433\u043D\u0430\u043B.\n02:18 \u2014 \u0448\u0430\u0433\u0438 \u041D\u0410\u0412\u0415\u0420\u0425\u0423, \u0445\u043E\u0442\u044F \u044F \u043E\u0434\u0438\u043D.\n02:21 \u2014 \u043C\u0430\u0448\u0438\u043D\u0430 \u0443 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438. \u041D\u043E\u043C\u0435\u0440 \u0442\u043E\u0442 \u0436\u0435.\n\n\u041D\u0435 \u0443\u0434\u0430\u043B\u044F\u0442\u044C \u0437\u0430\u043F\u0438\u0441\u044C. \u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043A\u0430\u043C\u0435\u0440 \u0438 \u0441\u0432\u0435\u0442 \u0432 \u0434\u043E\u043C\u0435 \u0440\u0430\u0437\u0432\u0435\u0434\u0435\u043D\u044B \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E."
