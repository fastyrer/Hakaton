  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ea85b00cbedd401c903924f6eb52ce3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.FatherHouse.HouseDocument
  kind: 5
  evidenceId: -1
  label: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C: \u041D\u0435\u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E\u0441\u0442\u0438"
  illustration: {fileID: 0}
  heading: "\u041D\u0435\u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E\u0441\u0442\u0438"
  body: "\u0420\u0430\u0434\u0438\u043E \u043B\u043E\u0432\u0438\u0442 \u0433\u043E\u043B\u043E\u0441\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u043B\u0443\u043D\u043E\u0447\u0438.\n\u0421\u0435\u0442\u0435\u0432\u0430\u044F \u0447\u0430\u0441\u0442\u043E\u0442\u0430 \u2014 \u043F\u043E\u043C\u0435\u0445\u0430, \u043D\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435.\n\n\u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443 \u044D\u043A\u0440\u0430\u043D\u0438\u0440\u043E\u0432\u043A\u0438. \u041F\u0435\u0440\u0435\u043D\u0435\u0441\u0442\u0438 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u044B\u0439 \u0431\u043B\u043E\u043A \u043F\u0438\u0442\u0430\u043D\u0438\u044F \u0432\u043D\u0438\u0437.\n\n\u0417\u0430 \u0441\u0442\u0435\u043D\u043E\u0439 \u0441\u043F\u0430\u043B\u044C\u043D\u0438 \u0441\u043D\u043E\u0432\u0430 \u0441\u043B\u044B\u0448\u043D\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435. \u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043E\u0442\u043C\u0435\u0442\u043A\u0438 \u043D\u0430 \u0434\u043E\u0441\u043A\u0430\u0445."
