  m_Script: {fileID: 11500000, guid: 2ea85b00cbedd401c903924f6eb52ce3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.FatherHouse.HouseDocument
  kind: 5
  evidenceId: -1
  label: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C: \u0417\u0430 \u0441\u0442\u0435\u043D\u043E\u0439"
  illustration: {fileID: 0}
  heading: "\u0417\u0430 \u0441\u0442\u0435\u043D\u043E\u0439"
  body: "\u0412\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u0435 \u0440\u0435\u0448\u0451\u0442\u043A\u0438 \u0434\u0430\u044E\u0442 \u0441\u043B\u044B\u0448\u0430\u0442\u044C \u043E\u0431\u0430 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430.\n\n\u041D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0437\u0434\u0435\u0441\u044C \u0444\u043E\u043D\u0430\u0440\u044C. \u0421\u0432\u0435\u0442 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0441\u043A\u0432\u043E\u0437\u044C \u0449\u0435\u043B\u044C \u0443 \u0448\u043A\u0430\u0444\u0430.\n\n\u0415\u0441\u043B\u0438 \u0434\u0432\u0435\u0440\u044C \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430 \u0443\u0436\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u0430 \u2014 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0447\u0435\u0440\u0435\u0437 \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u0439 \u0430\u0440\u0445\u0438\u0432."
