--- !u!114 &626350653
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 626350651}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ea85b00cbedd401c903924f6eb52ce3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.FatherHouse.HouseDocument
  kind: 5
  evidenceId: -1
  label: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C: \u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044B"
  illustration: {fileID: 0}
  heading: "\u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044B"
  body: "\u041D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435 \u043E\u0442\u0434\u0430\u0432\u0430\u0442\u044C \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044B.\n\n\u0412 \u043F\u0430\u043F\u043A\u0435 \u0437\u0430 \u043E\u043A\u0442\u044F\u0431\u0440\u044C \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0430 \u0434\u0430\u0442\u0430, \u043D\u043E \u0447\u0435\u0440\u043D\u0438\u043B\u0430 \u043D\u0430 \u043A\u043E\u043F\u0438\u0438 \u0441\u0432\u0435\u0436\u0438\u0435. \u042F \u043F\u043E\u043C\u043D\u044E \u0434\u0440\u0443\u0433\u0443\u044E \u043F\u043E\u0434\u043F\u0438\u0441\u044C.\n\n\u0424\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u044B\u043D\u043E\u0432\u044C\u044F\u043C. \u0412\u0441\u0451 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043B\u0435 \u0441\u0432\u0435\u0440\u043A\u0438 \u0441 \u0430\u0440\u0445\u0438\u0432\u043E\u043C \u0443\u0447\u0430\u0441\u0442\u043A\u0430."
