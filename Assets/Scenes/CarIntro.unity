--- !u!114 &2056498326
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2056498324}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ea85b00cbedd401c903924f6eb52ce3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.FatherHouse.HouseDocument
  kind: 5
  evidenceId: -1
  label: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C: \u041D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u043E\u043A\u043D\u0430"
  illustration: {fileID: 0}
  heading: "\u041D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u043E\u043A\u043D\u0430"
  body: "\u041A\u0430\u043C\u0435\u0440\u044B \u043D\u0435 \u0432\u0438\u0434\u044F\u0442 \u043F\u043E\u043B\u043E\u0441\u0443 \u043F\u043E\u0434 \u044F\u0431\u043B\u043E\u043D\u044F\u043C\u0438.\n\n\u041D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u043E\u043A\u043D\u0430 \u043F\u043E\u0441\u043B\u0435 \u0434\u0435\u0432\u044F\u0442\u0438. \u041D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0442\u044C, \u0435\u0441\u043B\u0438 \u043D\u0430\u0437\u043E\u0432\u0443\u0442 \u043C\u0435\u043D\u044F \u043F\u043E \u0438\u043C\u0435\u043D\u0438 \u0441 \u0443\u043B\u0438\u0446\u044B.\n\n\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0441\u043D\u043E\u0432\u0430 \u0441\u0434\u0432\u0438\u043D\u0443\u0442 \u0441\u0442\u0443\u043B. \u042F \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B \u0435\u0433\u043E \u0441\u043F\u0438\u043D\u043A\u043E\u0439 \u043A \u0434\u0432\u0435\u0440\u0438."
