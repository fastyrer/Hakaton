MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1442252266}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ea85b00cbedd401c903924f6eb52ce3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.FatherHouse.HouseDocument
  kind: 5
  evidenceId: -1
  label: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C: \u041F\u0438\u0442\u0430\u043D\u0438\u0435"
  illustration: {fileID: 0}
  heading: "\u041F\u0438\u0442\u0430\u043D\u0438\u0435"
  body: "\u0411\u0435\u043B\u0430\u044F \u043B\u0438\u043D\u0438\u044F \u2014 \u0434\u043E\u043C.\n\u041A\u0440\u0430\u0441\u043D\u0430\u044F \u043B\u0438\u043D\u0438\u044F \u2014 \u043D\u0430\u0440\u0443\u0436\u043D\u044B\u0435 \u043A\u0430\u043C\u0435\u0440\u044B.\n\u0427\u0451\u0440\u043D\u0430\u044F \u043B\u0438\u043D\u0438\u044F \u2014 \u0440\u0435\u0437\u0435\u0440\u0432.\n\n\u041F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0438 \u043D\u0435 \u0432\u0437\u0430\u0438\u043C\u043E\u0437\u0430\u043C\u0435\u043D\u044F\u0435\u043C\u044B. \u042F \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043B \u0438\u0445, \u043D\u043E \u043A\u0442\u043E-\u0442\u043E \u043C\u0435\u043D\u044F\u0435\u0442 \u043F\u043E\u0440\u044F\u0434\u043E\u043A."
