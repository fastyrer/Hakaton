  m_Script: {fileID: 11500000, guid: 2ea85b00cbedd401c903924f6eb52ce3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.FatherHouse.HouseDocument
  kind: 5
  evidenceId: -1
  label: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C: \u0417\u0435\u0440\u043A\u0430\u043B\u043E"
  illustration: {fileID: 0}
  heading: "\u0417\u0435\u0440\u043A\u0430\u043B\u043E"
  body: "\u0423\u0431\u0440\u0430\u0442\u044C \u0432\u0441\u0435 \u043E\u0442\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u0435 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0438\u0437 \u0441\u043F\u0430\u043B\u044C\u043D\u0438.\n\n\u041B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430 \u043F\u043E\u0441\u043B\u0435 \u0435\u0434\u044B. \u0412\u0440\u0430\u0447 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u044D\u0442\u043E \u043E\u0442 \u043D\u0435\u0434\u043E\u0441\u044B\u043F\u0430. \u0412\u0440\u0430\u0447 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B \u0437\u0430\u043F\u0438\u0441\u0438."
