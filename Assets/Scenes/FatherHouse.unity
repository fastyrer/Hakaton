--- !u!114 &2131751913
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2131751911}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ea85b00cbedd401c903924f6eb52ce3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hakaton.Demo.FatherHouse.HouseDocument
  kind: 5
  evidenceId: -1
  label: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C: \u041F\u043E\u0440\u044F\u0434\u043E\u043A \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439 \u043E\u0441\u0430\u0434\u044B"
  illustration: {fileID: 0}
  heading: "\u041F\u043E\u0440\u044F\u0434\u043E\u043A \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439 \u043E\u0441\u0430\u0434\u044B"
  body: "\u0412\u043E\u0434\u0430 \u2014 18 \u043A\u0430\u043D\u0438\u0441\u0442\u0440.\n\u041A\u043E\u043D\u0441\u0435\u0440\u0432\u044B \u2014 46 \u0431\u0430\u043D\u043E\u043A.\n\u041B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430 \u2014 \u0432 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0432\u0430\u043D\u043D\u043E\u0439.\n\u041D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u043F\u043B\u0438\u0442\u0443 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0441 \u043E\u0431\u043E\u0433\u0440\u0435\u0432\u0430\u0442\u0435\u043B\u0435\u043C.\n\n\u0415\u0441\u043B\u0438 \u043F\u043E\u0433\u0430\u0441\u043D\u0435\u0442 \u0441\u0432\u0435\u0442 \u2014 \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043F\u043E\u0434\u0432\u0430\u043B. \u041D\u0415 \u0412\u042B\u0425\u041E\u0414\u0418\u0422\u042C \u041D\u0410 \u0423\u041B\u0418\u0426\u0423."
