--- !u!1001 &1556886138
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 164106608}
    m_Modifications:
    - target: {fileID: 1478570663687825503, guid: 482325c7a3c694f06b5a4a966adedccb, type: 3}
      propertyPath: m_Name
      value: "\u0418\u0433\u0440\u043E\u043A \u0438 \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441"
      objectReference: {fileID: 0}
    - target: {fileID: 4572559298112132629, guid: 482325c7a3c694f06b5a4a966adedccb, type: 3}
      propertyPath: locationTitle
      value: "\u0414\u043E\u043C \u043E\u0442\u0446\u0430"
      objectReference: {fileID: 0}
    - target: {fileID: 4572559298112132629, guid: 482325c7a3c694f06b5a4a966adedccb, type: 3}
      propertyPath: locationObjective
      value: "\u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0434\u043E\u043C \u043E\u0442\u0446\u0430 \xB7 E \u2014 \u043E\u0441\u043C\u043E\u0442\u0440 \u0438 \u0434\u0432\u0435\u0440\u0438 \xB7 Tab \u2014 \u0434\u043E\u0441\u043A\u0430 \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F"
      objectReference: {fileID: 0}
    - target: {fileID: 4572559298112132629, guid: 482325c7a3c694f06b5a4a966adedccb, type: 3}
      propertyPath: evidence.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 4572559298112132629, guid: 482325c7a3c694f06b5a4a966adedccb, type: 3}
      propertyPath: locationIntroduction
      value: "\u0417\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C\u0438 \u0434\u043E\u043C\u0430\u043C\u0438 \u0434\u043E\u0440\u043E\u0433\u0430 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0432 \u043B\u0435\u0441\u043D\u0443\u044E \u043A\u043E\u043B\u0435\u044E.\n\u041E\u0442\u0435\u0446 \u0432\u0435\u043B\u0435\u043B \u043D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435 \u0441\u043E\u043E\u0431\u0449\u0430\u0442\u044C \u044D\u0442\u043E\u0442 \u0430\u0434\u0440\u0435\u0441.\n\n\u041E\u043A\u043D\u0430 \u0437\u0430\u043A\u043E\u043B\u043E\u0447\u0435\u043D\u044B \u0438\u0437\u043D\u0443\u0442\u0440\u0438. \u041D\u0430 \u0434\u0432\u0435\u0440\u0438 \u2014 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0441\u043E\u0432\u043E\u0432.\n\u041C\u0430\u0448\u0438\u043D\u0430 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0443 \u0432\u043E\u0440\u043E\u0442. \u041D\u0443\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u0435\u0433\u043E \u043A\u0430\u0431\u0438\u043D\u0435\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 4572559298112132629, guid: 482325c7a3c694f06b5a4a966adedccb, type: 3}
      propertyPath: 'evidence.Array.data[0]'
      value: 
      objectReference: {fileID: 1973088367}
