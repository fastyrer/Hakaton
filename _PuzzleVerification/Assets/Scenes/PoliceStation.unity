--- !u!1001 &1789273097
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1597784063}
    m_Modifications:
    - target: {fileID: 1478570663687825503, guid: 482325c7a3c694f06b5a4a966adedccb, type: 3}
      propertyPath: m_Name
      value: "\u0418\u0433\u0440\u043E\u043A \u0438 \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441"
      objectReference: {fileID: 0}
    - target: {fileID: 4572559298112132629, guid: 482325c7a3c694f06b5a4a966adedccb, type: 3}
      propertyPath: locationTitle
      value: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A"
      objectReference: {fileID: 0}
    - target: {fileID: 4572559298112132629, guid: 482325c7a3c694f06b5a4a966adedccb, type: 3}
      propertyPath: locationObjective
      value: "\u0410\u0440\u0445\u0438\u0432 \u2192 \u0434\u0435\u043B\u043E \u0412-97/041 \xB7 \u0441\u043E\u0431\u0435\u0440\u0438\u0442\u0435 3 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430 \xB7 \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0435 \u043A\u0430\u043B\u0438\u0431\u0440\u044B \u043D\u0430 \u0434\u043E\u0441\u043A\u0435 [Tab]"
      objectReference: {fileID: 0}
    - target: {fileID: 4572559298112132629, guid: 482325c7a3c694f06b5a4a966adedccb, type: 3}
      propertyPath: evidence.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 4572559298112132629, guid: 482325c7a3c694f06b5a4a966adedccb, type: 3}
      propertyPath: locationIntroduction
      value: "\u0422\u0440\u0438 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434 \u0434\u0435\u043B\u043E \u043E\u0442\u0446\u0430 \u0437\u0430\u043A\u0440\u044B\u043B\u0438 \u043A\u0430\u043A \u0441\u0430\u043C\u043E\u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E.\n\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u044B \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044B.\n\n\u0410\u0440\u0445\u0438\u0432 \u2014 \u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430 \u0441\u043F\u0440\u0430\u0432\u0430. \u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0434\u0435\u043B\u043E \u0412-97/041.\n\u0421\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B, \u043E\u043F\u0438\u0441\u044C \u043E\u0440\u0443\u0436\u0438\u044F \u0438 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 4572559298112132629, guid: 482325c7a3c694f06b5a4a966adedccb, type: 3}
      propertyPath: 'evidence.Array.data[3]'
      value: 
      objectReference: {fileID: 2082534840}
